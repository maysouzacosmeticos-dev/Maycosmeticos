rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PRODUTOS: leitura pública, escrita só admin
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // VENDAS: criação pública só no formato de pedido pendente
    match /sales/{saleId} {
      allow create: if request.resource.data.status == 'pendente'
                    && request.resource.data.amountPaid == 0;
      allow read, update, delete: if request.auth != null;
    }

    // CLIENTES: create público só se saldo for zerado
    match /customers/{customerId} {
      allow create: if request.resource.data.get('totalGasto', 0) == 0
                    && request.resource.data.get('totalDivida', 0) == 0;
      allow update: if request.auth != null
                    || request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['name','phone','address','lastPurchase']);
      allow read, delete: if request.auth != null;
    }

    // CONFIGURAÇÕES: leitura pública (o QR Pix depende disso), escrita só admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ANALYTICS: só pode incrementar o campo count
    match /analytics/visits {
      allow read: if request.auth != null;
      allow write: if request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['count']);
    }

    // Qualquer outra coisa: bloqueado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
