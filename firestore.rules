rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PRODUTOS: leitura pública, escrita só admin
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // VENDAS: Fechado para o público. Apenas Admin (ou a API Serverless via Admin SDK)
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }

    // CLIENTES: Fechado para o público. Apenas Admin (ou a API Serverless via Admin SDK)
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    // CONFIGURAÇÕES: leitura pública (o QR Pix depende disso), escrita só admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ANALYTICS: só pode incrementar o campo count
    match /analytics/visits {
      allow read: if request.auth != null;
      allow write: if request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['count']);
    }

    // Qualquer outra coisa: bloqueado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
